# Discord Bot(STEP 5)。.env にコピーして値を入れる。.env は gitignore 済み。

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# 投稿先チャンネルの ID(開発者モードを ON にしてチャンネルを右クリック → ID をコピー)
DISCORD_CHANNEL_ID=

# このファイル(.env.example)は git 管理対象。実トークンは書かず .env にだけ入れる。

# 黒板 JSON の保存先(省略時 blackboard-data/session-live.json)
BLACKBOARD_PATH=blackboard-data/session-live.json

# !auto / !run の最大ターン数
AUTO_CAP=8

# 1 にすると Mock 実装で動く(Claude 呼び出しなし、投稿の見た目確認用)
USE_MOCK=0
